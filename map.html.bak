<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>京都 9 天 · 互動地圖 · Map View</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700&family=Klee+One:wght@400;600&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #f5f0e6;
    --paper-dark: #ebe3d3;
    --ink: #2a2520;
    --ink-soft: #4a3f35;
    --vermillion: #c8463c;
    --vermillion-dark: #9d3329;
    --indigo: #2d4a5c;
    --gold: #b8893a;
    --moss: #6b7e3f;
    --shadow: rgba(42, 37, 32, 0.12);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    font-family: 'Noto Sans TC', 'Klee One', sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.5;
    overflow: hidden;
  }

  /* TOP BAR */
  .topbar {
    position: fixed; top: 0; left: 0; right: 0; height: 56px;
    background: rgba(245, 240, 230, 0.95);
    backdrop-filter: blur(20px);
    border-bottom: 2px solid var(--vermillion);
    display: flex; align-items: center; padding: 0 20px;
    z-index: 1000; gap: 16px;
  }
  .topbar-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 18px; font-weight: 600; color: var(--ink);
    white-space: nowrap;
  }
  .topbar-title .accent { color: var(--vermillion); }
  .day-filter {
    display: flex; gap: 4px; overflow-x: auto;
    flex: 1; padding: 0 8px;
  }
  .day-filter::-webkit-scrollbar { height: 0; }
  .day-btn {
    flex-shrink: 0; padding: 6px 12px;
    background: transparent; border: 1px solid rgba(42, 37, 32, 0.2);
    color: var(--ink-soft); font-size: 12px;
    font-family: 'Shippori Mincho', serif;
    cursor: pointer; border-radius: 2px;
    transition: all 0.15s; white-space: nowrap;
  }
  .day-btn:hover { border-color: var(--vermillion); color: var(--vermillion); }
  .day-btn.active {
    background: var(--vermillion); color: var(--paper);
    border-color: var(--vermillion);
  }
  .nav-link {
    padding: 6px 14px; background: var(--ink); color: var(--paper);
    text-decoration: none; font-size: 12px; border-radius: 2px;
    font-family: 'Shippori Mincho', serif; letter-spacing: 1px;
    white-space: nowrap;
  }
  .nav-link:hover { background: var(--vermillion); }

  /* LAYOUT */
  .layout {
    position: fixed; top: 56px; left: 0; right: 0; bottom: 0;
    display: grid; grid-template-columns: 380px 1fr;
  }

  /* SIDEBAR */
  .sidebar {
    background: var(--paper);
    border-right: 1px solid rgba(42, 37, 32, 0.1);
    overflow-y: auto;
    padding: 16px;
  }
  .sidebar::-webkit-scrollbar { width: 6px; }
  .sidebar::-webkit-scrollbar-track { background: transparent; }
  .sidebar::-webkit-scrollbar-thumb {
    background: rgba(42, 37, 32, 0.2);
    border-radius: 3px;
  }

  .day-section { margin-bottom: 24px; }
  .day-section.hidden { display: none; }
  .day-head {
    display: flex; align-items: baseline; gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1.5px solid var(--ink);
    margin-bottom: 12px;
  }
  .day-head-num {
    font-family: 'Shippori Mincho', serif;
    font-size: 28px; font-weight: 700;
    color: var(--vermillion); line-height: 1;
  }
  .day-head-meta {
    flex: 1;
  }
  .day-head-date {
    font-family: 'Shippori Mincho', serif;
    font-size: 11px; letter-spacing: 3px;
    color: var(--ink-soft);
  }
  .day-head-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 15px; font-weight: 600;
    color: var(--ink);
  }

  .stop-card {
    display: grid; grid-template-columns: 56px 1fr;
    gap: 10px; padding: 8px 10px;
    border-radius: 2px; cursor: pointer;
    transition: all 0.15s;
    border-left: 2px solid transparent;
    margin-bottom: 4px;
  }
  .stop-card:hover {
    background: rgba(255, 255, 255, 0.7);
    border-left-color: var(--vermillion);
  }
  .stop-card.active {
    background: rgba(200, 70, 60, 0.08);
    border-left-color: var(--vermillion);
  }
  .stop-card-time {
    font-family: 'Shippori Mincho', serif;
    font-size: 12px; font-weight: 600;
    color: var(--vermillion);
    line-height: 1.3; padding-top: 1px;
  }
  .stop-card-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 13px; font-weight: 500;
    color: var(--ink); line-height: 1.4;
    margin-bottom: 2px;
  }
  .stop-card-tag {
    display: inline-block;
    font-size: 9px; letter-spacing: 1px;
    padding: 1px 6px; border-radius: 2px;
    font-family: 'Shippori Mincho', serif;
  }
  .tag-shrine { background: rgba(200, 70, 60, 0.1); color: var(--vermillion); }
  .tag-temple { background: rgba(184, 137, 58, 0.12); color: var(--gold); }
  .tag-food { background: rgba(107, 126, 63, 0.12); color: var(--moss); }
  .tag-cafe { background: rgba(45, 74, 92, 0.12); color: var(--indigo); }
  .tag-scenery { background: rgba(74, 63, 53, 0.1); color: var(--ink-soft); }
  .tag-hotel { background: rgba(42, 37, 32, 0.08); color: var(--ink-soft); }
  .tag-transit { background: rgba(45, 74, 92, 0.08); color: var(--indigo); }
  .tag-shop { background: rgba(200, 70, 60, 0.08); color: var(--vermillion-dark); }

  /* MAP */
  #map {
    width: 100%; height: 100%;
  }
  .map-loading {
    position: absolute; inset: 0; display: flex;
    align-items: center; justify-content: center;
    background: var(--paper);
    font-family: 'Shippori Mincho', serif;
    color: var(--ink-soft); font-size: 14px;
    flex-direction: column; gap: 12px; text-align: center;
    padding: 24px;
  }
  .map-loading .err {
    color: var(--vermillion); max-width: 480px;
    line-height: 1.7;
  }

  /* DETAIL PANEL */
  .detail-panel {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: 380px; max-width: 100%;
    background: var(--paper);
    border-left: 1px solid rgba(42, 37, 32, 0.12);
    box-shadow: -8px 0 24px rgba(42, 37, 32, 0.08);
    transform: translateX(calc(100% + 24px));
    transition: transform 0.28s cubic-bezier(.4,0,.2,1);
    z-index: 50;
    overflow-y: auto;
    display: flex; flex-direction: column;
  }
  .detail-panel.open { transform: translateX(0); }
  .detail-panel::-webkit-scrollbar { width: 6px; }
  .detail-panel::-webkit-scrollbar-thumb { background: rgba(42, 37, 32, 0.2); border-radius: 3px; }

  .detail-photo {
    width: 100%; height: 200px; object-fit: cover;
    background: var(--paper-dark);
    flex-shrink: 0; display: block;
  }
  .detail-photo-placeholder {
    width: 100%; height: 80px;
    background: linear-gradient(135deg, var(--paper-dark) 0%, var(--paper) 100%);
    flex-shrink: 0;
  }
  .detail-close {
    position: absolute; top: 12px; right: 12px;
    width: 32px; height: 32px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(42, 37, 32, 0.1);
    cursor: pointer; display: flex;
    align-items: center; justify-content: center;
    font-size: 18px; color: var(--ink);
    transition: all 0.15s;
    box-shadow: 0 2px 6px rgba(42, 37, 32, 0.1);
    z-index: 2;
  }
  .detail-close:hover { background: var(--vermillion); color: white; border-color: var(--vermillion); }

  .detail-body { padding: 18px 22px 28px; flex: 1; }

  .detail-trip-badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: 'Shippori Mincho', serif;
    font-size: 11px; letter-spacing: 3px;
    color: var(--vermillion); font-weight: 600;
    margin-bottom: 8px;
  }
  .detail-trip-badge .day-dot {
    display: inline-block; width: 14px; height: 14px;
    border-radius: 50%; color: white;
    font-size: 9px; font-weight: 700;
    text-align: center; line-height: 14px;
    letter-spacing: 0;
  }

  .detail-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 22px; font-weight: 600;
    color: var(--ink); line-height: 1.3;
    margin-bottom: 10px;
  }

  .detail-rating {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: var(--ink-soft);
    margin-bottom: 14px;
  }
  .detail-rating .score {
    color: var(--vermillion); font-weight: 700;
    font-family: 'Shippori Mincho', serif;
  }
  .detail-rating .stars { color: var(--gold); letter-spacing: 1px; }

  .detail-tags {
    display: flex; gap: 6px; flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .detail-actions {
    display: flex; gap: 8px; margin-bottom: 20px;
    overflow-x: auto;
  }
  .detail-actions::-webkit-scrollbar { height: 0; }
  .detail-action {
    flex-shrink: 0; padding: 8px 14px;
    background: var(--paper-dark);
    border: 1px solid rgba(42, 37, 32, 0.12);
    border-radius: 18px;
    color: var(--ink); text-decoration: none;
    font-size: 12px; font-weight: 500;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 5px;
    transition: all 0.15s;
    font-family: inherit;
  }
  .detail-action:hover {
    background: var(--vermillion); color: white;
    border-color: var(--vermillion);
  }
  .detail-action .ico { font-size: 13px; }

  .detail-row {
    display: grid; grid-template-columns: 24px 1fr;
    gap: 10px; padding: 10px 0;
    border-bottom: 1px dashed rgba(42, 37, 32, 0.1);
    font-size: 13px; color: var(--ink-soft);
    line-height: 1.6;
  }
  .detail-row:last-child { border-bottom: none; }
  .detail-row .ico {
    font-size: 14px; color: var(--vermillion);
    line-height: 1.6;
  }
  .detail-row strong {
    color: var(--ink); font-weight: 600;
  }
  .detail-row a { color: var(--indigo); text-decoration: none; word-break: break-all; }
  .detail-row a:hover { color: var(--vermillion); text-decoration: underline; }

  .detail-hours-list { list-style: none; padding: 0; margin: 4px 0 0; }
  .detail-hours-list li {
    display: flex; justify-content: space-between;
    font-size: 12px; padding: 2px 0;
  }
  .detail-hours-list li.today { color: var(--vermillion); font-weight: 600; }

  .detail-notes {
    margin-top: 18px; padding: 14px 16px;
    background: rgba(255, 255, 255, 0.6);
    border-left: 3px solid var(--vermillion);
    border-radius: 2px;
    font-family: 'Klee One', cursive;
    font-size: 13px; color: var(--ink-soft);
    line-height: 1.7;
  }
  .detail-notes strong { color: var(--ink); }

  .detail-loading {
    color: var(--ink-soft); font-size: 12px;
    padding: 8px 0; opacity: 0.6;
  }

  /* MOBILE */
  @media (max-width: 768px) {
    .layout { grid-template-columns: 1fr; grid-template-rows: 45% 55%; }
    .sidebar { border-right: none; border-bottom: 1px solid rgba(42, 37, 32, 0.1); }
    .topbar-title { font-size: 14px; }
    .topbar { gap: 8px; padding: 0 12px; }
    .detail-panel { width: 100%; }
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-title">京都 <span class="accent">◆</span> Map</div>
  <div class="day-filter" id="dayFilter">
    <button class="day-btn active" data-day="all">全部</button>
    <button class="day-btn" data-day="1">D1</button>
    <button class="day-btn" data-day="2">D2</button>
    <button class="day-btn" data-day="3">D3</button>
    <button class="day-btn" data-day="4">D4</button>
    <button class="day-btn" data-day="5">D5</button>
    <button class="day-btn" data-day="6">D6</button>
    <button class="day-btn" data-day="7">D7</button>
    <button class="day-btn" data-day="8">D8</button>
    <button class="day-btn" data-day="9">D9</button>
  </div>
  <a href="index.html" class="nav-link">行程詳細</a>
</div>

<div class="layout">
  <aside class="sidebar" id="sidebar"></aside>
  <div style="position: relative;">
    <div id="map"></div>
    <div class="map-loading" id="mapLoading">
      <div>地圖載入中…</div>
      <div class="err" id="mapErr" style="display:none;"></div>
    </div>
    <aside class="detail-panel" id="detailPanel">
      <button class="detail-close" id="detailClose" aria-label="關閉">×</button>
      <div id="detailPhotoSlot"></div>
      <div class="detail-body" id="detailBody"></div>
    </aside>
  </div>
</div>

<script>
// ============ 資料：從 trips.json 載入 ============
let TRIP = [];
const stopRefs = []; // sidebar/marker 對應
let map;
const placeCache = new Map(); // placeId → Place 物件 (避免重複請求)
const routeOverlays = []; // { day, renderer? , line? } — 一律用同一個結構處理顯示/隱藏
let directionsService = null;
let directionsApiBroken = false; // 任一日請求失敗代表 API 沒開，後續全用 polyline 省 quota
let mapsApiReady = false;
let dataReady = false;

function tagLabel(t) {
  return ({ shrine:'神社', temple:'寺院', food:'美食', cafe:'咖啡', scenery:'景點',
    hotel:'住宿', transit:'交通', shop:'購物' })[t] || t;
}

function adaptStop(stop) {
  const firstTag = (stop.tags && stop.tags[0]) || { key: 'scenery', label: '' };
  return {
    time: stop.time,
    title: stop.title,
    star: !!stop.star,
    tags: stop.tags || [],
    tag: firstTag.key,
    lat: stop.lat,
    lng: stop.lng,
    placeId: stop.placeId || null,
    notes: stop.notes || ''
  };
}

function adaptDay(day) {
  return {
    day: day.day,
    date: `${day.date} (${day.weekday})`,
    title: day.title,
    color: day.color,
    stops: day.stops.map(adaptStop)
  };
}

const sidebar = document.getElementById('sidebar');

function renderSidebar() {
  sidebar.innerHTML = '';
  stopRefs.length = 0;
  let stopIdx = 0;
  TRIP.forEach((day) => {
    const sec = document.createElement('div');
    sec.className = 'day-section';
    sec.dataset.day = day.day;
    sec.innerHTML = `
      <div class="day-head">
        <div class="day-head-num">0${day.day}</div>
        <div class="day-head-meta">
          <div class="day-head-date">${day.date}</div>
          <div class="day-head-title">${day.title}</div>
        </div>
      </div>
    `;
    day.stops.forEach((stop) => {
      const card = document.createElement('div');
      card.className = 'stop-card';
      card.dataset.stopIdx = stopIdx;
      card.innerHTML = `
        <div class="stop-card-time">${stop.time}</div>
        <div>
          <div class="stop-card-title">${stop.star ? '★ ' : ''}${stop.title}</div>
          <span class="stop-card-tag tag-${stop.tag}">${tagLabel(stop.tag)}</span>
        </div>
      `;
      const idx = stopIdx;
      card.addEventListener('click', () => focusStop(idx));
      sec.appendChild(card);
      stopRefs.push({ stop, day, card, marker: null });
      stopIdx++;
    });
    sidebar.appendChild(sec);
  });
}

const dayFilter = document.getElementById('dayFilter');
let activeDay = 'all';
dayFilter.addEventListener('click', (e) => {
  if (e.target.tagName !== 'BUTTON') return;
  activeDay = e.target.dataset.day;
  document.querySelectorAll('.day-btn').forEach(b => b.classList.toggle('active', b === e.target));
  document.querySelectorAll('.day-section').forEach(sec => {
    sec.classList.toggle('hidden', activeDay !== 'all' && sec.dataset.day !== activeDay);
  });
  applyMapFilter();
});

function initMap() {
  mapsApiReady = true;
  if (dataReady) renderMap();
}

function renderMap() {
  document.getElementById('mapLoading').style.display = 'none';

  map = new google.maps.Map(document.getElementById('map'), {
    center: { lat: 35.0050, lng: 135.7681 },
    zoom: 12,
    mapTypeControl: false,
    streetViewControl: false,
    fullscreenControl: true,
    clickableIcons: false,
    styles: [
      // 隱藏所有 Google 內建 POI 圖標跟文字（保留我們自己的 markers）
      { featureType: "poi", stylers: [{ visibility: "off" }] },
      // 保留公園、自然景觀的綠色底色當地理參考，但拿掉文字
      { featureType: "poi.park", elementType: "geometry", stylers: [{ visibility: "on" }] },
      { featureType: "landscape.natural", elementType: "geometry", stylers: [{ visibility: "on" }] },
      // 隱藏交通站點圖示（保留 transit.line 讓鐵道線還看得到）
      { featureType: "transit.station", stylers: [{ visibility: "off" }] }
    ]
  });

  stopRefs.forEach((ref, idx) => {
    const { stop, day } = ref;
    if (stop.lat == null || stop.lng == null) return;
    const marker = new google.maps.Marker({
      position: { lat: stop.lat, lng: stop.lng },
      map,
      title: `${stop.time} ${stop.title}`,
      icon: {
        path: google.maps.SymbolPath.CIRCLE,
        scale: 8,
        fillColor: day.color,
        fillOpacity: 1,
        strokeColor: '#fff',
        strokeWeight: 2
      },
      label: {
        text: String(day.day),
        color: '#fff',
        fontSize: '10px',
        fontWeight: '700'
      }
    });
    marker.addListener('click', () => focusStop(idx));
    ref.marker = marker;
  });

  directionsService = new google.maps.DirectionsService();
  TRIP.forEach((day) => renderRoute(day));
}

// 嘗試用 Directions API 畫實際路線；失敗就退回直線
function renderRoute(day) {
  const stopsWithCoords = day.stops.filter(s => s.lat != null && s.lng != null);
  if (stopsWithCoords.length < 2) return;

  const drawFallbackPolyline = () => {
    const path = stopsWithCoords.map(s => ({ lat: s.lat, lng: s.lng }));
    const line = new google.maps.Polyline({
      path, geodesic: true,
      strokeColor: day.color,
      strokeOpacity: 0.4,
      strokeWeight: 2,
      map
    });
    routeOverlays.push({ day: day.day, line });
  };

  if (directionsApiBroken) {
    drawFallbackPolyline();
    return;
  }

  const origin = stopsWithCoords[0];
  const destination = stopsWithCoords[stopsWithCoords.length - 1];
  const waypoints = stopsWithCoords.slice(1, -1).map(s => ({
    location: { lat: s.lat, lng: s.lng },
    stopover: false
  }));

  directionsService.route({
    origin: { lat: origin.lat, lng: origin.lng },
    destination: { lat: destination.lat, lng: destination.lng },
    waypoints,
    travelMode: google.maps.TravelMode.DRIVING,
    optimizeWaypoints: false
  }).then(result => {
    const renderer = new google.maps.DirectionsRenderer({
      directions: result,
      map,
      suppressMarkers: true,
      preserveViewport: true,
      polylineOptions: {
        strokeColor: day.color,
        strokeOpacity: 0.75,
        strokeWeight: 4
      }
    });
    routeOverlays.push({ day: day.day, renderer });
  }).catch(err => {
    console.warn(`Day ${day.day} Directions failed:`, err && err.message ? err.message : err);
    if (err && /not.*authorized|REQUEST_DENIED|API.*disabled/i.test(err.message || '')) {
      directionsApiBroken = true;
      showDirectionsHint();
    }
    drawFallbackPolyline();
  });
}

function showDirectionsHint() {
  if (document.getElementById('directionsHint')) return;
  const hint = document.createElement('div');
  hint.id = 'directionsHint';
  hint.style.cssText = 'position:absolute;bottom:12px;left:12px;right:12px;max-width:520px;background:rgba(255,255,255,0.96);border:1px solid rgba(200,70,60,0.3);border-left:3px solid var(--vermillion);padding:10px 14px;font-size:12px;color:var(--ink-soft);z-index:30;border-radius:2px;line-height:1.6;box-shadow:0 2px 8px rgba(42,37,32,0.1);';
  hint.innerHTML = '⚠️ 路線 API 未啟用，已改用直線連線。<br>若要看實際路線：到 Google Cloud Console 把 <strong>Directions API</strong> 加入此 key 的「API 限制」清單。';
  hint.addEventListener('click', () => hint.remove());
  document.querySelector('.layout > div:last-child').appendChild(hint);
}

function applyMapFilter() {
  if (!map) return;
  stopRefs.forEach(ref => {
    if (!ref.marker) return;
    const visible = activeDay === 'all' || String(ref.day.day) === activeDay;
    ref.marker.setMap(visible ? map : null);
  });
  routeOverlays.forEach(o => {
    const visible = activeDay === 'all' || String(o.day) === activeDay;
    if (o.renderer) o.renderer.setMap(visible ? map : null);
    else if (o.line) o.line.setMap(visible ? map : null);
  });
  if (activeDay !== 'all') {
    const bounds = new google.maps.LatLngBounds();
    stopRefs.forEach(ref => {
      if (ref.marker && String(ref.day.day) === activeDay) bounds.extend(ref.marker.getPosition());
    });
    if (!bounds.isEmpty()) map.fitBounds(bounds, 60);
  }
}

let lastActiveCard = null;
function focusStop(idx) {
  const ref = stopRefs[idx];
  if (!ref) return;
  if (lastActiveCard) lastActiveCard.classList.remove('active');
  ref.card.classList.add('active');
  lastActiveCard = ref.card;
  ref.card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  if (map && ref.marker) {
    map.panTo(ref.marker.getPosition());
    if (map.getZoom() < 14) map.setZoom(15);
  }
  openDetailPanel(ref);
}

// ============ 詳細資訊面板 ============
const WEEKDAYS_JP = ['日','一','二','三','四','五','六'];
const detailPanel = document.getElementById('detailPanel');
const detailBody = document.getElementById('detailBody');
const detailPhotoSlot = document.getElementById('detailPhotoSlot');
document.getElementById('detailClose').addEventListener('click', closeDetailPanel);
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDetailPanel(); });

function closeDetailPanel() {
  detailPanel.classList.remove('open');
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
}

function renderTripBlock(ref) {
  const { stop, day } = ref;
  const tagsHtml = stop.tags.map(t => `<span class="stop-card-tag tag-${t.key}">${tagLabel(t.key)}${t.label && t.label !== tagLabel(t.key) ? ' · ' + escapeHtml(t.label) : ''}</span>`).join('');
  return `
    <div class="detail-trip-badge">
      <span class="day-dot" style="background:${day.color}">${day.day}</span>
      DAY ${day.day} · ${stop.time}
    </div>
    <div class="detail-title">${stop.star ? '★ ' : ''}${escapeHtml(stop.title)}</div>
    <div class="detail-tags">${tagsHtml}</div>
  `;
}

function renderActions(stop, place) {
  const actions = [];
  // Open in Google Maps
  if (place && place.googleMapsURI) {
    actions.push({ ico: '◉', label: '在 Maps 開啟', href: place.googleMapsURI });
  } else if (stop.placeId) {
    actions.push({ ico: '◉', label: '在 Maps 開啟', href: `https://www.google.com/maps/search/?api=1&query=${stop.lat},${stop.lng}&query_place_id=${stop.placeId}` });
  } else if (stop.lat != null) {
    actions.push({ ico: '◉', label: '在 Maps 開啟', href: `https://www.google.com/maps/search/?api=1&query=${stop.lat},${stop.lng}` });
  }
  // Directions
  if (stop.placeId) {
    actions.push({ ico: '↗', label: '路線', href: `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(stop.title)}&destination_place_id=${stop.placeId}` });
  } else if (stop.lat != null) {
    actions.push({ ico: '↗', label: '路線', href: `https://www.google.com/maps/dir/?api=1&destination=${stop.lat},${stop.lng}` });
  }
  if (place) {
    if (place.websiteURI) actions.push({ ico: '🌐', label: '網站', href: place.websiteURI });
    if (place.internationalPhoneNumber) actions.push({ ico: '📞', label: '電話', href: `tel:${place.internationalPhoneNumber.replace(/\s/g, '')}` });
  }
  if (!actions.length) return '';
  return `<div class="detail-actions">${actions.map(a =>
    `<a class="detail-action" target="_blank" rel="noopener" href="${a.href}"><span class="ico">${a.ico}</span>${a.label}</a>`
  ).join('')}</div>`;
}

function renderRating(place) {
  if (!place || place.rating == null) return '';
  const score = place.rating.toFixed(1);
  const filled = Math.round(place.rating);
  const stars = '★'.repeat(filled) + '☆'.repeat(5 - filled);
  const reviews = place.userRatingCount ? ` (${place.userRatingCount.toLocaleString()})` : '';
  return `<div class="detail-rating">
    <span class="score">${score}</span>
    <span class="stars">${stars}</span>
    <span>${reviews}</span>
  </div>`;
}

function renderPlaceInfo(place) {
  if (!place) return '';
  const rows = [];
  if (place.formattedAddress) {
    rows.push(`<div class="detail-row"><span class="ico">📍</span><div>${escapeHtml(place.formattedAddress)}</div></div>`);
  }
  if (place.regularOpeningHours && place.regularOpeningHours.weekdayDescriptions) {
    const today = new Date().getDay();
    // Google 的 weekdayDescriptions 索引 0 = 週一，所以星期天要從 6 取
    const todayIdx = today === 0 ? 6 : today - 1;
    const hoursList = place.regularOpeningHours.weekdayDescriptions.map((line, i) =>
      `<li class="${i === todayIdx ? 'today' : ''}">${escapeHtml(line)}</li>`
    ).join('');
    rows.push(`<div class="detail-row"><span class="ico">🕒</span><div><strong>營業時間</strong><ul class="detail-hours-list">${hoursList}</ul></div></div>`);
  }
  if (place.internationalPhoneNumber) {
    rows.push(`<div class="detail-row"><span class="ico">📞</span><div><a href="tel:${place.internationalPhoneNumber.replace(/\s/g,'')}">${escapeHtml(place.internationalPhoneNumber)}</a></div></div>`);
  }
  if (place.websiteURI) {
    rows.push(`<div class="detail-row"><span class="ico">🌐</span><div><a target="_blank" rel="noopener" href="${place.websiteURI}">${escapeHtml(place.websiteURI.replace(/^https?:\/\//, '').replace(/\/$/, ''))}</a></div></div>`);
  }
  return rows.join('');
}

function renderNotes(stop) {
  if (!stop.notes) return '';
  return `<div class="detail-notes">${stop.notes}</div>`;
}

function renderPhoto(place) {
  if (place && place.photos && place.photos.length) {
    try {
      const photoUrl = place.photos[0].getURI({ maxWidth: 800, maxHeight: 400 });
      return `<img class="detail-photo" src="${photoUrl}" alt="" onerror="this.outerHTML='<div class=&quot;detail-photo-placeholder&quot;></div>'">`;
    } catch (e) { /* fallthrough */ }
  }
  return `<div class="detail-photo-placeholder"></div>`;
}

async function openDetailPanel(ref) {
  const { stop } = ref;
  // 先用我們自己的資料畫一份（即時開啟，不卡）
  detailPhotoSlot.innerHTML = `<div class="detail-photo-placeholder"></div>`;
  detailBody.innerHTML = renderTripBlock(ref)
    + renderActions(stop, null)
    + (stop.placeId ? `<div class="detail-loading">載入 Place 詳細資料…</div>` : '')
    + renderNotes(stop);
  detailPanel.classList.add('open');
  detailPanel.scrollTop = 0;

  // 沒 placeId 的就只顯示我們自己的資料
  if (!stop.placeId) return;

  // Places API (New) 抓詳細
  if (!window.google?.maps?.places?.Place) return;

  try {
    let place = placeCache.get(stop.placeId);
    if (!place) {
      place = new google.maps.places.Place({ id: stop.placeId });
      await place.fetchFields({
        fields: ['displayName', 'formattedAddress', 'rating', 'userRatingCount',
                 'regularOpeningHours', 'websiteURI', 'internationalPhoneNumber',
                 'photos', 'googleMapsURI']
      });
      placeCache.set(stop.placeId, place);
    }
    // 確認使用者沒有切到別張卡片才更新（避免 race）
    if (!detailPanel.classList.contains('open')) return;
    detailPhotoSlot.innerHTML = renderPhoto(place);
    detailBody.innerHTML = renderTripBlock(ref)
      + renderRating(place)
      + renderActions(stop, place)
      + renderPlaceInfo(place)
      + renderNotes(stop);
  } catch (err) {
    console.error('Place fetch failed:', err);
    detailBody.innerHTML = renderTripBlock(ref)
      + renderActions(stop, null)
      + `<div class="detail-row"><span class="ico">⚠️</span><div style="color:var(--vermillion);font-size:12px;">Place 詳細資料載入失敗：${escapeHtml(err.message || String(err))}</div></div>`
      + renderNotes(stop);
  }
}

function loadMapsApi() {
  const params = new URLSearchParams(location.search);
  const apiKey = params.get('key') || 'YOUR_GOOGLE_MAPS_API_KEY';

  if (apiKey === 'YOUR_GOOGLE_MAPS_API_KEY') {
    document.getElementById('mapErr').style.display = 'block';
    document.getElementById('mapErr').innerHTML =
      '⚠️ 尚未設定 Google Maps API key。<br>' +
      '在網址加上 <code>?key=你的KEY</code>。<br>' +
      '部署於 GitHub Pages 才能載入（API key 已設定 referrer 限制）。';
    return;
  }

  const s = document.createElement('script');
  s.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(apiKey)}&libraries=places&callback=initMap&loading=async`;
  s.async = true;
  s.defer = true;
  s.onerror = () => {
    document.getElementById('mapErr').style.display = 'block';
    document.getElementById('mapErr').textContent = '⚠️ 地圖載入失敗，請檢查 API key 與網域限制。';
  };
  document.head.appendChild(s);
}

function loadTrips() {
  return fetch('trips.json')
    .then(r => {
      if (!r.ok) throw new Error(`trips.json HTTP ${r.status}`);
      return r.json();
    })
    .then(data => {
      TRIP = data.days.map(adaptDay);
      renderSidebar();
      dataReady = true;
      if (mapsApiReady) renderMap();
    })
    .catch(err => {
      const errEl = document.getElementById('mapErr');
      errEl.style.display = 'block';
      errEl.textContent = `⚠️ trips.json 載入失敗：${err.message}`;
      sidebar.innerHTML = `<div style="padding:20px;color:var(--vermillion);font-size:13px;">⚠️ 行程資料載入失敗：${err.message}</div>`;
      console.error(err);
    });
}

window.initMap = initMap;
loadTrips();
loadMapsApi();
</script>
</body>
</html>
